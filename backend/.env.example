# Configurações do SYNAPSE Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Banco de Dados de Metadados (SQLite)
DATABASE_URL=sqlite:///./synapse.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# Integração n8n Local
N8N_BASE_URL=http://localhost:5678
N8N_DISCOVERY_WEBHOOK_URL=http://localhost:5678/webhook/synapse-intelligent-discovery
N8N_DATA_BRIDGE_WEBHOOK_URL=http://localhost:5678/webhook/synapse-data-bridge
N8N_TIMEOUT_SECONDS=15.0
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_AUTH_VALUE=

# Limites de Segurança
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls,.tsv

# Administração segura (limpeza permanece desligada por padrão)
AUTH_REQUIRED=false
OPERATOR_API_KEY=
DESTRUCTIVE_OPERATIONS_ENABLED=true
ADMIN_MAINTENANCE_ENABLED=false
ADMIN_API_KEY=

# Login humano dos avaliadores (obrigatório em staging/production)
EVALUATOR_EMAIL=
EVALUATOR_PASSWORD_HASH=
EVALUATOR_SESSION_TTL_MINUTES=60
EVALUATOR_LOGIN_MAX_ATTEMPTS=5
EVALUATOR_LOGIN_WINDOW_SECONDS=900
