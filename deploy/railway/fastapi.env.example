# Railway / FastAPI staging (valores de exemplo; gere os segredos no painel)
ENVIRONMENT=staging
DATABASE_URL=${{Postgres.DATABASE_URL}}
CORS_ORIGINS=https://synapse-staging.example.vercel.app
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
N8N_BASE_URL=https://synapse-n8n-staging.example.up.railway.app
N8N_DISCOVERY_WEBHOOK_URL=https://synapse-n8n-staging.example.up.railway.app/webhook/synapse-intelligent-discovery
N8N_DATA_BRIDGE_WEBHOOK_URL=https://synapse-n8n-staging.example.up.railway.app/webhook/synapse-data-bridge
N8N_TIMEOUT_SECONDS=15
N8N_WEBHOOK_AUTH_HEADER=X-Synapse-Webhook-Key
N8N_WEBHOOK_AUTH_VALUE=<CONFIGURE_NO_RAILWAY_E_NO_FRONTEND>
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls,.tsv
AUTH_REQUIRED=true
OPERATOR_API_KEY=<CONFIGURE_NO_RAILWAY>
ADMIN_API_KEY=<CONFIGURE_NO_RAILWAY>
DESTRUCTIVE_OPERATIONS_ENABLED=false
ADMIN_MAINTENANCE_ENABLED=false
SEED_DEMO_DATA=false
